}

.message p{
  max-width:650px;
  line-height:2.2;
  margin:0;
}

.signature{
  line-height:1;
  margin-top:38px;
}


/* =========================================================
   RECRUIT
   ========================================================= */

.recruit .split{
  align-items:start;
}

.recruit-copy{
  max-width:700px;
  min-width:0;
}

.recruit h3{
  max-width:650px;
  line-height:1.55;
  margin:0 0 26px;
  letter-spacing:.07em;
}

.recruit p{
  max-width:650px;
  line-height:2.15;
  margin:0;
}

.side-words{
  align-self:end;
}


/* =========================================================
   COMPANY / CONTACT
   ========================================================= */

.bottom-grid{
  align-items:start;
}

.bottom-title{
  line-height:1.2;
}

.bottom-sub{
  line-height:1.7;
}

