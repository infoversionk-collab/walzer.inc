/* =========================================================
   WALZER / CLASSIC BLUE / 20s RECRUIT
   文字被り防止を最優先に設計
   ========================================================= */

:root{
  --navy:#063a6d;
  --deep:#032b50;
  --blue:#1d6da8;
  --ice:#eef8fb;
  --white:#fff;
  --gold:#b89b67;
  --serif:"Noto Serif JP",serif;
  --eng:"Cormorant Garamond",serif;
  --shadow:0 22px 60px rgba(5,53,91,.14);
}

*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;
  color:var(--navy);
  background:#f7fbfc;
  font-family:var(--serif);
  line-height:1.9;
  overflow-x:hidden;
}
body.menu-open{overflow:hidden}
a{color:inherit;text-decoration:none}
button{font:inherit}
.container{width:min(1160px,calc(100% - 64px));margin-inline:auto}
.container-wide{width:min(1320px,calc(100% - 64px));margin-inline:auto}

/* ---------- HEADER ---------- */
.site-header{
  position:fixed;
  inset:0 0 auto;
  height:92px;
  z-index:100;
  color:#fff;
  transition:.35s ease;
  background:linear-gradient(180deg,rgba(2,35,63,.28),transparent);
}
.site-header.is-scrolled{
  color:var(--navy);
  background:rgba(248,252,253,.94);
  backdrop-filter:blur(18px);
  box-shadow:0 8px 30px rgba(8,53,90,.08);
}
.nav{
  height:100%;
  display:flex;
  align-items:center;
  justify-content:space-between;
}
.logo{display:flex;align-items:baseline;gap:14px;flex:none}
.logo-main{
  font-family:var(--eng);
  font-size:48px;
  line-height:1;
  letter-spacing:.07em;
}
.logo-sub{font-size:11px;letter-spacing:.16em}
.nav-links{display:flex;align-items:center;gap:30px}
.nav-links a{
  font-family:var(--eng);
  font-size:12px;
  letter-spacing:.17em;
  position:relative;
  padding:10px 0;
}
.nav-links a::after{
  content:"";
  position:absolute;
  left:0;bottom:3px;
  width:0;height:1px;
  background:currentColor;
  transition:.3s;
}
.nav-links a:hover::after{width:100%}
.menu-btn{display:none}

/* ---------- COMMON ---------- */
.section{position:relative;overflow:hidden}
.section-grid{
  display:grid;
  grid-template-columns:180px minmax(0,1fr);
  gap:72px;
  align-items:start;
}
.section-label h2{
  margin:0 0 7px;
  font-family:var(--eng);
  font-size:58px;
  font-weight:500;
  line-height:1;
  letter-spacing:.14em;
}
.section-label h2::after{
  content:"";
  display:block;
  width:30px;height:1px;
  margin-top:18px;
  background:var(--gold);
}
.section-label p{
  margin:0;
  font-size:11px;
  letter-spacing:.22em;
}
.body-copy{
  margin:0;
  font-size:14px;
  line-height:2.2;
  letter-spacing:.055em;
}
.lead-copy{
  margin:0 0 28px;
  font-size:clamp(30px,3.5vw,50px);
  line-height:1.65;
  letter-spacing:.08em;
}
.keywords{
  display:flex;
  flex-wrap:wrap;
  gap:30px;
  margin-top:36px;
  color:#6c8ba5;
  font-family:var(--eng);
  font-size:13px;
  letter-spacing:.25em;
}
.reveal{
  opacity:0;
  transform:translateY(26px);
  transition:opacity .8s ease,transform .8s ease;
}
.reveal.visible{opacity:1;transform:none}

/* ---------- HERO ---------- */
.hero{
  min-height:900px;
  height:100svh;
  max-height:1050px;
  position:relative;
  display:flex;
  align-items:center;
  isolation:isolate;
}
.hero-bg{
  position:absolute;
  inset:0;
  z-index:-2;
  background:
    linear-gradient(90deg,
      rgba(247,252,254,.98) 0%,
      rgba(247,252,254,.90) 27%,
      rgba(247,252,254,.58) 48%,
      rgba(247,252,254,.12) 78%,
      rgba(247,252,254,0) 100%),
    url("../assets/water-light.webp") center/cover no-repeat;
}
.hero::after{
  content:"";
  position:absolute;
  z-index:-1;
  left:-5%;
  bottom:-75px;
  width:110%;
  height:140px;
  background:#f7fbfc;
  border-radius:50% 50% 0 0 / 100% 100% 0 0;
}
.hero-inner{
  position:relative;
  width:min(1160px,calc(100% - 64px));
  padding-top:40px;
}
.hero-copy{max-width:720px}
.hero-company{
  margin:0 0 28px;
  padding-left:55px;
  position:relative;
  font-size:16px;
  letter-spacing:.2em;
}
.hero-company::before{
  content:"";
  position:absolute;
  left:0;top:50%;
  width:40px;height:1px;
  background:var(--gold);
}
.hero h1{
  margin:0;
  font-size:clamp(62px,8vw,112px);
  line-height:1.28;
  font-weight:500;
  letter-spacing:.09em;
  text-shadow:0 2px 20px rgba(255,255,255,.95);
}
.hero-lead{
  margin:25px 0 3px;
  font-size:21px;
  letter-spacing:.15em;
}
.hero-en{
  margin:0;
  color:var(--gold);
  font-family:var(--eng);
  font-size:18px;
  letter-spacing:.2em;
}
.scroll-indicator{
  position:absolute;
  left:0;
  bottom:125px;
  display:flex;
  flex-direction:column;
  align-items:center;
  gap:10px;
  font-family:var(--eng);
  font-size:10px;
  letter-spacing:.35em;
}
.scroll-indicator i{
  width:1px;height:65px;
  background:currentColor;
  animation:scrollLine 1.8s ease-in-out infinite;
}
@keyframes scrollLine{
  0%,100%{transform:scaleY(.35);transform-origin:top}
  50%{transform:scaleY(1);transform-origin:top}
}

/* ---------- ABOUT ---------- */
.about{
  padding:145px 0 155px;
  background:
    linear-gradient(90deg,
      rgba(255,255,255,.99) 0%,
      rgba(255,255,255,.96) 35%,
      rgba(255,255,255,.80) 67%,
      rgba(255,255,255,.34) 100%),
    url("../assets/floral-light.webp") right center/cover no-repeat;
}
.about-content{
  max-width:820px;
  padding-top:5px;
}

/* ---------- SERVICES ---------- */
.services{
  padding:110px 0 145px;
  background:
    linear-gradient(180deg,rgba(247,251,252,.97),rgba(235,247,251,.90)),
    url("../assets/floral-light.webp") center/cover no-repeat;
}
.section-heading{
  display:grid;
  grid-template-columns:180px minmax(0,1fr);
  gap:72px;
  align-items:end;
  margin-bottom:42px;
}
.section-heading > p{
  margin:0 0 2px;
  font-size:14px;
  letter-spacing:.06em;
}
.service-grid{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  gap:18px;
}
.service-card{
  min-height:370px;
  position:relative;
  overflow:hidden;
  border-radius:5px;
  color:#fff;
  box-shadow:var(--shadow);
  isolation:isolate;
}
.service-image,
.service-overlay{
  position:absolute;
  inset:0;
}
.service-image{
  z-index:-2;
  background-position:center;
  background-size:cover;
  transition:transform .7s ease;
}
.service-image-1,.service-image-3{background-image:url("../assets/water-light.webp")}
.service-image-2{background-image:url("../assets/floral-light.webp")}
.service-overlay{
  z-index:-1;
  background:linear-gradient(180deg,
    rgba(2,40,70,.10) 0%,
    rgba(2,40,70,.28) 36%,
    rgba(2,40,70,.90) 100%);
}
.service-card:hover .service-image{transform:scale(1.06)}
.service-content{
  height:100%;
  min-height:370px;
  padding:25px;
  display:grid;
  grid-template-rows:auto 1fr auto;
  gap:15px;
}
.service-number{
  font-family:var(--eng);
  font-size:27px;
  color:#e0c897;
  letter-spacing:.12em;
}
.service-content h3{
  margin:0 0 3px;
  font-size:25px;
  font-weight:500;
  letter-spacing:.06em;
}
.service-content p{
  margin:0;
  font-family:var(--eng);
  font-size:11px;
  letter-spacing:.18em;
}
.service-desc{
  display:block;
  max-width:300px;
  margin-top:13px;
  font-size:13px;
  line-height:1.8;
}
.circle-arrow{
  width:38px;height:38px;
  border:1px solid rgba(255,255,255,.82);
  border-radius:50%;
  display:grid;
  place-items:center;
  font-family:Arial,sans-serif;
  transition:.3s;
}
.service-card:hover .circle-arrow{
  background:#fff;
  color:var(--navy);
  transform:rotate(-45deg);
}

/* ---------- MESSAGE ---------- */
.message{
  min-height:780px;
  padding:155px 0 180px;
  color:#fff;
  isolation:isolate;
}
.message-bg{
  position:absolute;
  inset:0;
  z-index:-2;
  background:
    linear-gradient(90deg,
      rgba(1,27,47,.94) 0%,
      rgba(1,27,47,.88) 32%,
      rgba(1,27,47,.56) 59%,
      rgba(1,27,47,.18) 100%),
    url("../assets/message-flower.webp") center 48%/cover no-repeat;
}
.message::after{
  content:"";
  position:absolute;
  left:-5%;bottom:-80px;
  width:110%;height:150px;
  background:#f7fbfc;
  border-radius:50% 50% 0 0/100% 100% 0 0;
  z-index:0;
}
.message > .container{position:relative;z-index:2}
.message .section-label h2::after{background:#dec797}
.message-content{max-width:690px;padding-right:30px}
.message-kicker,.recruit-kicker{
  margin:0 0 18px;
  color:#d9c18e;
  font-family:var(--eng);
  font-size:13px;
  letter-spacing:.25em;
}
.message-content h3{
  margin:0 0 28px;
  font-size:clamp(32px,4vw,53px);
  font-weight:500;
  line-height:1.55;
  letter-spacing:.07em;
}
.message .body-copy{text-shadow:0 1px 9px rgba(0,0,0,.3)}
.signature{
  margin:30px 0 0;
  color:#dec797;
  font-family:var(--eng);
  font-style:italic;
  font-size:48px;
}

/* ---------- RECRUIT ---------- */
.recruit{
  padding:145px 0 155px;
  background:
    linear-gradient(90deg,
      rgba(255,255,255,.99) 0%,
      rgba(255,255,255,.95) 38%,
      rgba(255,255,255,.72) 70%,
      rgba(255,255,255,.24) 100%),
    url("../assets/water-light.webp") center/cover no-repeat;
}
.recruit-grid{position:relative}
.recruit-content{max-width:720px}
.recruit-content h3{
  margin:0 0 25px;
  font-size:clamp(32px,3.7vw,50px);
  font-weight:500;
  line-height:1.6;
  letter-spacing:.07em;
}
.outline-btn{
  width:220px;
  margin-top:27px;
  padding:13px 20px 13px 25px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  border:1px solid var(--navy);
  border-radius:999px;
  font-size:13px;
  letter-spacing:.13em;
  transition:.3s;
}
.outline-btn:hover{
  color:#fff;
  background:var(--navy);
  transform:translateX(5px);
}
.side-words{
  position:absolute;
  right:0;
  top:20px;
  font-family:var(--eng);
  font-size:12px;
  line-height:2.15;
  letter-spacing:.34em;
  opacity:.8;
}

/* ---------- COMPANY / CONTACT ---------- */
.bottom{
  position:relative;
  padding:100px 0 80px;
  color:#fff;
  isolation:isolate;
}
.bottom-bg{
  position:absolute;
  inset:0;
  z-index:-2;
  background:
    linear-gradient(rgba(3,48,74,.55),rgba(3,48,74,.66)),
    url("../assets/floral-light.webp") center/cover no-repeat;
}
.bottom-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:80px;
}
.bottom-block h2{
  margin:0 0 3px;
  font-family:var(--eng);
  font-size:38px;
  font-weight:500;
  letter-spacing:.16em;
}
.bottom-block > p{
  margin:0;
  font-size:11px;
  letter-spacing:.18em;
}
.bottom-links{
  display:flex;
  flex-wrap:wrap;
  gap:25px;
  margin-top:20px;
  font-size:12px;
  letter-spacing:.12em;
}
.bottom-links a:hover{text-decoration:underline;text-underline-offset:5px}
.contact-block{
  padding-left:45px;
  border-left:1px solid rgba(255,255,255,.55);
}
.contact-copy{
  margin:22px 0 18px;
  font-size:13px;
  line-height:2;
}
.contact-btn{
  width:205px;
  padding:11px 20px 11px 22px;
  display:flex;
  justify-content:space-between;
  border:1px solid #fff;
  border-radius:999px;
  font-size:12px;
  letter-spacing:.13em;
  transition:.3s;
}
.contact-btn:hover{background:#fff;color:var(--navy)}

/* ---------- FOOTER ---------- */
footer{
  padding:20px 0;
  background:#f7fbfc;
  color:var(--navy);
}
.footer-inner{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:25px;
}
.footer-logo{
  margin-right:12px;
  font-family:var(--eng);
  font-size:29px;
  letter-spacing:.06em;
}
.footer-inner > div:first-child span:last-child{font-size:10px;letter-spacing:.13em}
.footer-links{
  display:flex;
  flex-wrap:wrap;
  gap:18px;
  font-size:9px;
  letter-spacing:.08em;
}

/* ---------- TABLET ---------- */
@media(max-width:980px){
  .container,.container-wide{width:min(100% - 48px,1160px)}
  .nav-links{gap:18px}
  .nav-links a{font-size:11px}
  .section-grid,.section-heading{
    grid-template-columns:145px minmax(0,1fr);
    gap:45px;
  }
  .service-grid{grid-template-columns:1fr}
  .service-card,.service-content{min-height:300px}
  .side-words{display:none}
}

/* ---------- MOBILE ---------- */
@media(max-width:700px){
  .container,.container-wide{width:calc(100% - 36px)}
  .site-header{height:72px}
  .logo-main{font-size:38px}
  .logo-sub{font-size:9px}
  .menu-btn{
    display:grid;
    place-items:center;
    width:43px;height:43px;
    border:1px solid currentColor;
    border-radius:50%;
    background:transparent;
    color:inherit;
    cursor:pointer;
    position:relative;
    z-index:102;
  }
  .menu-btn span,
  .menu-btn span::before,
  .menu-btn span::after{
    display:block;
    width:16px;height:1px;
    background:currentColor;
    content:"";
    position:absolute;
    transition:.3s;
  }
  .menu-btn span::before{transform:translateY(-6px)}
  .menu-btn span::after{transform:translateY(6px)}
  .menu-btn.is-open span{background:transparent}
  .menu-btn.is-open span::before{transform:rotate(45deg)}
  .menu-btn.is-open span::after{transform:rotate(-45deg)}

  .nav-links{
    position:fixed;
    inset:0;
    z-index:101;
    width:100%;
    height:100svh;
    padding:110px 36px 40px;
    display:flex;
    flex-direction:column;
    align-items:flex-start;
    justify-content:center;
    gap:20px;
    background:rgba(247,251,252,.98);
    color:var(--navy);
    opacity:0;
    visibility:hidden;
    transform:translateY(-10px);
    transition:.35s ease;
  }
  .nav-links.is-open{
    opacity:1;
    visibility:visible;
    transform:none;
  }
  .nav-links a{font-size:20px;letter-spacing:.18em}

  .hero{
    min-height:700px;
    height:100svh;
  }
  .hero-bg{
    background:
      linear-gradient(180deg,
        rgba(247,252,254,.97) 0%,
        rgba(247,252,254,.84) 44%,
        rgba(247,252,254,.22) 100%),
      url("../assets/water-light.webp") center/cover no-repeat;
  }
  .hero-inner{padding-top:30px}
  .hero-company{font-size:13px;padding-left:43px;margin-bottom:20px}
  .hero-company::before{width:30px}
  .hero h1{
    font-size:clamp(44px,12vw,58px);
    line-height:1.42;
    letter-spacing:.055em;
  }
  .hero-lead{font-size:15px;letter-spacing:.09em;margin-top:18px}
  .hero-en{font-size:13px;letter-spacing:.13em}
  .scroll-indicator{left:0;bottom:82px}

  .section-grid,.section-heading{
    grid-template-columns:1fr;
    gap:28px;
  }
  .section-label h2{font-size:45px}
  .section-label h2::after{margin-top:14px}
  .section-label p{font-size:10px}
  .body-copy{font-size:13px;line-height:2.15}
  .lead-copy{font-size:27px;line-height:1.7}

  .about{
    padding:95px 0 110px;
    background:
      linear-gradient(180deg,
        rgba(255,255,255,.99) 0%,
        rgba(255,255,255,.94) 62%,
        rgba(255,255,255,.50) 100%),
      url("../assets/floral-light.webp") center/cover no-repeat;
  }

  .services{padding:85px 0 105px}
  .section-heading > p{font-size:13px;margin-top:-8px}
  .service-card,.service-content{min-height:330px}
  .service-content{padding:23px}
  .service-content h3{font-size:22px}
  .service-desc{font-size:12px}

  .message{
    min-height:720px;
    padding:105px 0 130px;
  }
  .message-bg{
    background:
      linear-gradient(180deg,
        rgba(1,27,47,.95) 0%,
        rgba(1,27,47,.78) 54%,
        rgba(1,27,47,.48) 100%),
      url("../assets/message-flower.webp") center/cover no-repeat;
  }
  .message-content{padding:0}
  .message-content h3{font-size:29px;line-height:1.65}
  .signature{font-size:38px}
  .message::after{bottom:-70px;height:120px}

  .recruit{
    padding:100px 0 115px;
    background:
      linear-gradient(180deg,
        rgba(255,255,255,.99) 0%,
        rgba(255,255,255,.90) 60%,
        rgba(255,255,255,.48) 100%),
      url("../assets/water-light.webp") center/cover no-repeat;
  }
  .recruit-content h3{font-size:29px}
  .outline-btn{width:205px}

  .bottom{padding:78px 0 55px}
  .bottom-grid{grid-template-columns:1fr;gap:42px}
  .contact-block{
    padding:30px 0 0;
    border-left:0;
    border-top:1px solid rgba(255,255,255,.55);
  }
  .footer-inner{
    align-items:flex-start;
    flex-direction:column;
    gap:12px;
  }
}

@media(prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{
    animation:none!important;
    transition:none!important;
  }
}
